# Required
COMPUTER_ACTIONS_SERVICE_URL=ws://localhost:3000
COMPUTER_ACTIONS_SERVICE_API_KEY=<paste-the-apiKey-from-the-tenant>

# Optional – give this machine a stable identity across restarts
RUNNER_ID=
RUNNER_NAME=my-machine
RUNNER_LABELS=macos,arm64,automation

# CUA input backend (auto-detected from platform if not set)
#   cliclick   — macOS  (brew install cliclick)       <- recommended on macOS
#   xdotool    — Linux  (apt install xdotool)          <- recommended on Linux
#   pyautogui  — any platform, legacy fallback
#   auto       — pick from platform (default)
CUA_BACKEND=auto

# ─── Agent (run_task) ─────────────────────────────────────────────────────────
# Required only for the `run_task` high-level action (LLM-driven computer use).
ANTHROPIC_API_KEY=

# Model to use for autonomous tasks  (default: claude-3-5-sonnet-20241022)
# Claude 3.5 Sonnet is recommended — it has the best computer-use support.
# CUA_AGENT_MODEL=claude-3-5-sonnet-20241022

# Maximum LLM steps per run_task call  (default: 50)
# CUA_AGENT_MAX_STEPS=50
